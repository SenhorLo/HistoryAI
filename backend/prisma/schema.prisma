generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String? // nulo quando a conta foi criada via Google
  googleId      String?        @unique
  // como o usuário quer ser chamado. Nulo até ele informar — aí a saudação
  // do chat cai no prefixo do e-mail
  displayName   String?
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  attachments   Attachment[]
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String       @db.Text
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  attachments    Attachment[]
}

/*
  Arquivo enviado junto de uma pergunta.

  Guardamos o TEXTO EXTRAÍDO, não os bytes. O motivo é que o histórico é
  remontado do banco a cada mensagem (as APIs de LLM são stateless) e o disco
  do Render é efêmero: um arquivo guardado em disco sumiria no próximo deploy
  e a conversa ficaria com uma referência quebrada. Extrair uma vez também
  significa pagar os tokens do arquivo uma vez, e não em todo turno seguinte.

  O arquivo original nunca é gravado nem servido — o que dispensa autenticar
  /api/files para conteúdo pessoal.
*/
model Attachment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // nulo entre o envio do arquivo e o envio da pergunta. Um anexo que fique
  // nulo por muito tempo é lixo de um envio abandonado e é recolhido depois.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  name          String
  mimeType      String
  size          Int
  kind          String
  extractedText String   @db.Text
  createdAt     DateTime @default(now())

  // cobre tanto "os anexos desta mensagem" quanto a varredura de órfãos
  @@index([userId, messageId])
  @@index([messageId])
}
